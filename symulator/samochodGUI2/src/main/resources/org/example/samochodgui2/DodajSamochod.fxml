<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.samochodgui2.DodajSamochodController"
      spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Model:"/>
    <TextField fx:id="modelField"/>

    <Label text="Numer rejestracyjny:"/>
    <TextField fx:id="nrRejField"/>

    <Label text="Prędkość maksymalna [km/h]:"/>
    <TextField fx:id="vmaxField"/>

    <Label text="Silnik:"/>
    <ComboBox fx:id="engineComboBox" prefWidth="200.0"/>

    <Label text="Skrzynia biegów:"/>
    <ComboBox fx:id="gearboxComboBox" prefWidth="200.0"/>


    <HBox spacing="10">
        <Button text="Zatwierdź" onAction="#onConfirm"/>
        <Button text="Anuluj" onAction="#onCancel"/>
    </HBox>
</VBox>